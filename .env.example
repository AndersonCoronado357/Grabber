DB_HOST=
DB_PORT=
DB_INSTANCE=
DB_NAME=
DB_NAME_TEST=
DB_USER=
# entre comillas simples si contiene # o $ (dotenv trunca valores sin comillas en #)
DB_PASSWORD=
DB_ENCRYPT=
DB_TRUST_SERVER_CERT=
PORT=
NODE_ENV=
CORS_ORIGIN=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
TOTP_ENCRYPTION_KEY=
DOWNLOAD_ROOT=
AVATAR_ROOT=
YTDLP_PATH=
MAX_CONCURRENT_DOWNLOADS=
GUEST_DOWNLOAD_LIMIT=
TRASH_RETENTION_DAYS=

# Web Push (VAPID) — genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Wompi (pasarela de pago, COP). sandbox = pruebas (pub_test_/prv_test_),
# production = dinero real (pub_prod_/prv_prod_). Sin llaves, los pagos quedan
# deshabilitados y los planes de pago no se pueden activar.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL pública del frontend para el redirect tras pagar (vacío = host de la petición)
APP_URL=
